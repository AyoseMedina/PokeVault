# Generar credenciales / Generate credentials:
# node server/create-credentials.mjs --write-env
# Sin Node local: usa el generador dentro de Docker (ver EMPEZAR.md).
# Without local Node: run the generator in Docker (see GETTING_STARTED.md).
# No hay valores predeterminados / No default credentials.
POKEVAULT_USERNAME=
POKEVAULT_PASSWORD_HASH=
POKEVAULT_SESSION_SECRET=
# Local: http://localhost:8080, solo en el host / host only.
POKEVAULT_PORT=8080
# Opcional: conserva un origen local existente / Preserve an existing local origin.
# POKEVAULT_ORIGIN=http://127.0.0.1:8080
# Nube / Cloud (compose.cloud.yaml): dominio sin https:// ni ruta.
# Domain without scheme or path. Configure DNS first.
POKEVAULT_DOMAIN=
