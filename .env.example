# Generar credenciales / Generate credentials:
# node server/create-credentials.mjs --write-env
# Sin Node local: usa el generador dentro de Docker (ver EMPEZAR.md).
# Without local Node: run the generator in Docker (see GETTING_STARTED.md).
# No hay valores predeterminados / No default credentials.
POKEVAULT_USERNAME=
POKEVAULT_PASSWORD_HASH=
POKEVAULT_SESSION_SECRET=
# Clave de cifrado del banco: guárdala también fuera del servidor; sin ella se pierde el banco.
# Bank encryption key: keep a copy outside the server; losing it loses the bank.
POKEVAULT_DATA_KEY=
# Local: http://localhost:8080, solo en el host / host only.
# Solo compose.yaml (local) / Only compose.yaml (local).
# POKEVAULT_PORT=8080
# Opcional: conserva un origen local existente / Preserve an existing local origin.
# POKEVAULT_ORIGIN=http://127.0.0.1:8080
# Portainer + proxy existente / existing proxy (docker-compose.yml):
# POKEVAULT_ORIGIN=https://pokevault.tudominio.com
# IP del proxy vista por el backend / proxy IP as seen by the backend.
# POKEVAULT_TRUST_PROXY=192.168.1.10
# docker-compose.yml: puerto interno 8080, sin publicar en host ni configurar tu red.
# Internal port 8080, no host port or external network configured.
# Nube / Cloud (compose.cloud.yaml): dominio sin https:// ni ruta.
# Domain without scheme or path. Configure DNS first.
POKEVAULT_DOMAIN=
